# Secrets wiring for the StreamPay stack.
#
# Policy: Terraform knows the *names* of every secret and the mechanism that
# delivers it, never the value. `terraform.tfstate` therefore stays safe to
# snapshot, plan output stays safe to paste into a PR, and the rendered bundle
# stays safe to commit. docs/DEPLOYMENT.md carries the provider tradeoff table.
#
# Shape: one `lookup()` per strategy, then a shared splitter that writes one
# 0600 env file per service. Per-service isolation matters because the extender
# key funds transactions: the Grafana container must not carry it any more than
# the indexer should.

locals {
  service_keys = sort(keys(var.service_secret_names))
  all_names    = distinct(flatten([for k in local.service_keys : var.service_secret_names[k]]))
  agent_file   = var.vault_agent_file != "" ? var.vault_agent_file : "${var.install_dir}/streampay-secrets.agent.env"

  secret_path = {
    for idx, k in local.service_keys :
    k => "${var.install_dir}/streampay-secrets-${k}.env"
  }

  k8s_secret_by_service = {
    for k in local.service_keys : k => "${var.k8s_secret_prefix}-${k}"
  }

  # A `$` in these heredocs is literal unless followed by `{`; `$${` is how a
  # real shell `${VAR:-default}` reaches the rendered file.
  script_head = <<-SH
    #!/bin/sh
    # Generated by terraform (modules/secrets). Delivers the StreamPay secret
    # env files at mode ${var.secrets_file_mode}, one per service, without ever
    # printing a value. Idempotent: re-running rewrites every file from source.
    set -eu

    INSTALL_DIR="${var.install_dir}"
    MISSING=""
    STRICT_FAILED=""
    STRICT_NAMES="${join(" ", var.strict_names)}"

    note_missing() {
      MISSING="$MISSING $1"
      case " $STRICT_NAMES " in
        *" $1 "*) STRICT_FAILED="$STRICT_FAILED $1" ;;
      esac
    }

    # split DEST NAME... -- writes DEST from lookup(NAME) for each NAME. A value
    # carrying a newline cannot be expressed in KEY=VALUE form, so it fails loud
    # instead of writing a truncated secret.
    split() {
      dest="$1"
      shift
      count="$#"
      umask 077
      mkdir -p "$(dirname "$dest")"
      tmp="$(mktemp "$dest.XXXXXX")"
      : > "$tmp"
      found=0
      for name in "$@"; do
        val="$(lookup "$name" 2>/dev/null || true)"
        if [ -z "$val" ]; then
          note_missing "$name"
          continue
        fi
        if [ "$(printf '%s' "$val" | wc -l)" -gt 0 ]; then
          echo "secret $name contains a newline; refusing to write it into an env file" >&2
          rm -f "$tmp"
          exit 1
        fi
        printf '%s=%s\n' "$name" "$val" >> "$tmp"
        found=$((found + 1))
      done
      chmod ${var.secrets_file_mode} "$tmp"
      mv -f "$tmp" "$dest"
      echo "$dest: $found of $count key(s)"
    }
    SH

  # `env`: the deploying shell already holds the values -- an operator exported
  # them, or CI injected them. Nothing persists beyond the local 0600 files.
  lookup_env = <<-SH
    preflight() { :; }

    lookup() {
      printenv "$1" 2>/dev/null || true
    }
    SH

  # `file`: a config-management tool or SCP owns one union file; Terraform audits
  # it and splits it, so a loose mode is caught at apply time, not at incident
  # time.
  lookup_file = <<-SH
    OPERATOR_FILE="${var.operator_file}"

    preflight() {
      if [ ! -f "$OPERATOR_FILE" ]; then
        echo "strategy=file expects the operator to own $OPERATOR_FILE; it is missing" >&2
        exit 1
      fi
      mode="$(stat -c '%a' "$OPERATOR_FILE" 2>/dev/null || echo unknown)"
      case "$mode" in
        600|400|640) : ;;
        *) echo "$OPERATOR_FILE is mode $mode; must be 600, 400 or 640" >&2; exit 1 ;;
      esac
    }

    lookup() {
      sed -n "s/^$1=//p" "$OPERATOR_FILE" | head -n 1
    }
    SH

  # `ssm`: SecureStrings pulled at boot through the instance profile, so no
  # long-lived cloud credential lives on the host between boots.
  lookup_ssm = <<-SH
    SSM_PREFIX="${var.ssm_path_prefix}"
    SSM_REGION="${var.ssm_region}"

    preflight() {
      if ! command -v aws >/dev/null 2>&1; then
        echo "strategy=ssm needs the aws-cli on the host" >&2
        exit 1
      fi
      if [ -z "$SSM_PREFIX" ]; then
        echo "strategy=ssm needs ssm_path_prefix" >&2
        exit 1
      fi
    }

    lookup() {
      if [ -n "$SSM_REGION" ]; then
        aws ssm get-parameter --region "$SSM_REGION" --with-decryption \\
          --name "$SSM_PREFIX/$1" --query Parameter.Value --output text 2>/dev/null || true
      else
        aws ssm get-parameter --with-decryption \\
          --name "$SSM_PREFIX/$1" --query Parameter.Value --output text 2>/dev/null || true
      fi
    }
    SH

  # `vault`: prefer whatever Vault Agent already templated out (so a container
  # restart needs no fresh Vault round trip); fall back to the CLI.
  lookup_vault = <<-SH
    AGENT_FILE="${local.agent_file}"
    VAULT_MOUNT="${var.vault_mount}"

    preflight() {
      if [ ! -s "$AGENT_FILE" ] && ! command -v vault >/dev/null 2>&1; then
        echo "strategy=vault needs a running vault agent (see vault-agent.hcl) or the vault CLI" >&2
        exit 1
      fi
    }

    lookup() {
      if [ -s "$AGENT_FILE" ]; then
        sed -n "s/^$1=//p" "$AGENT_FILE" | head -n 1
      else
        vault kv get -field="$1" "$VAULT_MOUNT" 2>/dev/null || true
      fi
    }
    SH

  lookup_k8s = <<-SH
    preflight() { :; }

    lookup() {
      # strategy=k8s_secret has no host-side source; workloads read the Secret
      # through envFrom. See the create command in the bundle README.
      return 0
    }
    SH

  lookups = {
    env        = local.lookup_env
    file       = local.lookup_file
    ssm        = local.lookup_ssm
    vault      = local.lookup_vault
    k8s_secret = local.lookup_k8s
  }

  split_calls = join("\n", [
    for k in local.service_keys :
    length(var.service_secret_names[k]) > 0
    ? "split \"${local.secret_path[k]}\" ${join(" ", var.service_secret_names[k])}"
    : "# ${k}: needs no secrets"
  ])

  missing_block_note = <<-SH
    if [ -n "$MISSING" ]; then
      echo "note: not provided by the source:$MISSING" >&2
    fi
    SH
  missing_block_hard = <<-SH
    if [ -n "$MISSING" ]; then
      echo "secrets unavailable:$MISSING" >&2
      exit 1
    fi
    SH

  # Optional secrets are a note, required ones fail the fetch: a stack that comes
  # up with an empty Grafana admin password is worse than one that does not come
  # up.
  missing_block = var.skip_missing ? local.missing_block_note : local.missing_block_hard

  script_tail = <<-SH
    preflight

    ${local.split_calls}

    if [ -n "$STRICT_FAILED" ]; then
      echo "required secrets unavailable:$STRICT_FAILED" >&2
      exit 1
    fi
    ${local.missing_block}
    echo "secret files ready under $INSTALL_DIR"
    SH

  # Rendered commands, not a rendered Secret: Terraform never holds the value.
  # The `:?` guard means a name the operator forgot to export fails on the spot
  # instead of creating a Secret with an empty entry, which is the k8s equivalent
  # of an unset key and much harder to notice.
  k8s_create_commands = join("\n", [
    for k in local.service_keys :
    length(var.service_secret_names[k]) > 0 ? join(" ", concat(
      ["kubectl -n NAMESPACE create secret generic ${local.k8s_secret_by_service[k]}"],
      [for n in var.service_secret_names[k] : "--from-literal=${n}=\"$${${n}:?${n} is required}\""]
    )) : "# ${k}: needs no Secret (no secret environment it reads)"
  ])

  fetch_script = var.strategy == "k8s_secret" ? join("\n", [
    "#!/bin/sh",
    "# strategy=k8s_secret: nothing runs on a host. Create the per-service",
    "# Secrets once, out of band, from a shell that already has the values:",
    "#",
    local.k8s_create_commands,
    "#",
    "# Never build them from a file that lives in git.",
    "echo 'strategy=k8s_secret: no host-side work'",
    ]) : join("\n", [
    local.script_head,
    local.lookups[var.strategy],
    local.script_tail,
  ])

  # Line-built HCL instead of a nested heredoc: the agent template carries a
  # heredoc of its own, and two levels of `<<` in one file reads badly.
  vault_agent_lines = concat(
    [
      "# Vault Agent config generated by terraform (modules/secrets).",
      "# Run: vault agent -config=vault-agent.hcl",
      "# AppRole keeps any credential out of this file; on the Kubernetes path",
      "# prefer the Vault Agent injector with the Kubernetes auth method.",
      "auto_auth {",
      "  method \"approle\" {",
      "    mount_path = \"auth/approle\"",
      "    config = {",
      "      role_id_file_path                   = \"${var.install_dir}/vault-role-id\"",
      "      secret_id_file_path                 = \"${var.install_dir}/vault-secret-id\"",
      "      remove_secret_id_file_after_reading = true",
      "    }",
      "  }",
      "  sink \"file\" {",
      "    config = { path = \"${var.install_dir}/vault-token\" }",
      "  }",
      "}",
      "",
      "template {",
      "  destination = \"${local.agent_file}\"",
      "  perms       = \"600\"",
      "  create      = true",
      "  contents = <<EOT",
    ],
    [for name in local.all_names : "${name}={{- with secret \"${var.vault_mount}\" }}{{ .Data.data.${name} }}{{- end }}"],
    ["EOT", "}"]
  )

  threat_notes = {
    env        = "Nothing is stored server-side and rotation is one restart, but anyone who can read the host environment (root, /proc/1/environ, a debug sidecar) holds the funded extender key. Right for a VM you own; wrong for a shared cluster."
    file       = "No cloud dependency, and the file is 0600 -- but plaintext sits on disk, and whatever delivers it (Ansible, SCP, a human) has to carry the value somewhere. Terraform cannot see it change, so the script audits mode and key coverage on every apply."
    ssm        = "Values never reach git, state or an image, and reads are CloudTrail-auditable with least-privilege per-path IAM. New blast radius: any process that can call ssm:GetParameter with this instance profile can exfiltrate, so scope the role to the exact ARNs -- and accept that an AWS outage blocks restarts."
    vault      = "Same no-plaintext property plus short-lived agent certs, lease rotation and one story across clouds. The tradeoff is availability: Vault must be reachable and unsealed for the stack to restart, and AppRole/Kubernetes auth is its own subsystem to secure."
    k8s_secret = "Native and simple, but etcd keeps Secrets base64-encoded, not encrypted unless you enabled the encryption config: treat namespace get-secrets as holding a funded key. Lock RBAC down, or graduate to sealed-secrets / external-secrets without touching this module's outputs."
  }
}
