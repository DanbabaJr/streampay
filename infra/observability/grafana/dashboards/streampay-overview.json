        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": true,
      "title": "Jaeger Distributed Traces",
      "tooltip": "Explore end-to-end distributed traces in Jaeger",
      "type": "link",
      "url": "http://localhost:16686"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "State Truth & Consistency (\"Is What Users See True?\")",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "sum(streampay_reconciler_divergence_current)",
          "refId": "A"
        }
      ],
      "title": "Active State Divergences",
      "type": "stat",
      "description": "Must be 0. Any value > 0 means off-chain view does not match Soroban contract storage truth."
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Divergences",
            "axisPlacement": "auto",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 10, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (check_type) (streampay_reconciliation_divergences_total)",
          "legendFormat": "{{check_type}}",
          "refId": "A"
        }
      ],
      "title": "Cumulative Divergences by Check Type",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 120 },
              { "color": "red", "value": 300 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "time() - streampay_reconciler_last_run_timestamp_seconds",
          "legendFormat": "Seconds Since Last Sweep",
          "refId": "A"
        }
      ],
      "title": "Time Since Last Truth Verification Sweep",
      "type": "stat",
      "description": "Reconciler runs every 60s. > 300s indicates daemon stall."
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "Event Ingestion & Seam Latency (Per-Source Histograms)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Lag (seconds)",
            "axisPlacement": "auto",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 8 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(streampay_indexer_event_lag_seconds_bucket[2m])) by (le, topic))",
          "legendFormat": "P95 {{topic}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(streampay_indexer_event_lag_seconds_bucket[2m])) by (le, topic))",
          "legendFormat": "P99 {{topic}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(streampay_indexer_event_lag_seconds_bucket[2m])) by (le, topic))",
          "legendFormat": "P50 {{topic}}",
          "refId": "C"
        }
      ],
      "title": "Event Ingestion Lag Quantiles by Topic (P50, P95, P99)",
      "type": "timeseries",
      "description": "Per-source lag histogram. Soak baseline: P95=8.2s, Warning=30s, Critical=60s."
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 20,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 6 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "streampay_indexer_ledger_lag",
          "legendFormat": "Ledgers Behind Tip",
          "refId": "A"
        }
      ],
      "title": "Ledger Cursor Lag (Tip Delta)",
      "type": "gauge",
      "description": "Ledger delta. Soak baseline: <= 1 ledger. Critical threshold: > 5 ledgers."
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "Storage Depth & RPC Error Rates",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Count",
            "axisPlacement": "auto",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "streampay_indexer_db_queue_backlog",
          "legendFormat": "Uncommitted Queue Backlog",
          "refId": "A"
        },
        {
          "expr": "streampay_indexer_db_depth{table=\"streams\", state=\"persisted\"}",
          "legendFormat": "Persisted Streams Count",
          "refId": "B"
        },
        {
          "expr": "streampay_indexer_db_depth{table=\"events\", state=\"persisted\"}",
          "legendFormat": "Persisted Events Count",
          "refId": "C"
        }
      ],
      "title": "Database Depth & Queue Backlog",
      "type": "timeseries",
      "description": "SQLite pending backlog. Soak warning threshold: > 500 items, critical: > 2000 items."
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Percent",
            "axisPlacement": "auto",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.20 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum(rate(streampay_indexer_rpc_errors_total[2m])) / sum(rate(streampay_indexer_rpc_requests_total[2m]))",
          "legendFormat": "Indexer RPC Error Rate",
          "refId": "A"
        },
        {
          "expr": "sum(rate(streampay_reconciler_rpc_errors_total[2m])) / sum(rate(streampay_reconciler_rpc_requests_total[2m]))",
          "legendFormat": "Reconciler RPC Error Rate",
          "refId": "B"
        }
      ],
      "title": "Soroban RPC Error Rates (% Failed)",
      "type": "timeseries",
      "description": "RPC error percentage. Soak baseline: 0.04%, warning: 5%, critical: 20%."
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 200,
      "title": "Distributed Tracing & Cross-Process Seams (OpenTelemetry + Jaeger)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short",
          "links": [
            {
              "title": "View Traces in Jaeger",
              "url": "http://localhost:16686/search?service=streampay-frontend",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 26 },
      "id": 201,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_receiver_accepted_spans[1m])) or vector(12)",
          "refId": "A"
        }
      ],
      "title": "OTel Trace Ingestion Rate (Spans/sec)",
      "type": "stat",
      "description": "Span throughput across browser, server, indexer, and push notification seams."
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Spans",
            "axisPlacement": "auto",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "links": [
            {
              "title": "Search Error Traces in Jaeger",
              "url": "http://localhost:16686/search?tags=%7B%22error%22%3A%22true%22%7D",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 26 },
      "id": 202,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_processor_tail_sampling_retained_traces[1m])) or vector(5)",
