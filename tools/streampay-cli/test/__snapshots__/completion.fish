# fish completion for streampay. Generated by `streampay completion fish`; do not edit.
function __streampay_positionals
    set -l tokens (commandline -opc)
    set -e tokens[1]
    set -l skip 0
    for t in $tokens
        if test $skip -eq 1
            set skip 0
            continue
        end
        switch $t
            case --contract --network --rpc-url --passphrase --signer --source --key-file --secret-env --password-env --signed-xdr --token --recipient --deposit --days --stream-id --amount --out
                set skip 1
            case '-*'
            case '*'
                echo $t
        end
    end
end

function __streampay_depth
    test (count (__streampay_positionals)) -eq $argv[1]
end

function __streampay_is
    set -l p (__streampay_positionals)
    for i in (seq (count $argv))
        test "$p[$i]" = "$argv[$i]"; or return 1
    end
end

