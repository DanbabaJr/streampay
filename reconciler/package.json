{
  "name": "streampay-reconciler",
  "version": "1.0.0",
  "description": "Three-way reconciliation across Soroban RPC, Horizon and the indexer projection, with governance-gated heal proposals",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "node --import=tsx src/index.ts",
    "pretest": "npm run build",
    "test": "node --test tests/**/*.test.js",
    "test:fixtures": "node --test tests/threeway.test.js tests/heal.test.js",
    "soak": "node tests/soak-test.js"
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}