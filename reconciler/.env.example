# Horizon Configuration (classic-bridge effects source)
HORIZON_URL=https://horizon-testnet.stellar.org
HORIZON_API_TOKEN=

# Soroban RPC Configuration (contract state source)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org/rpc
SOROBAN_RPC_TOKEN=

# Webhook target (indexer dashboard - Issue #2)
WEBHOOK_URL=http://localhost:8080/webhooks/reconciler

# Consistency & polling
CONSISTENCY_WINDOW_MS=30000
POLL_INTERVAL_MS=5000

# Logging
LOG_LEVEL=INFO
SERVICE_NAME=streampay-reconciler
ENVIRONMENT=testnet
RECONCILER_ID=primary-001