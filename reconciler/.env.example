# Horizon Configuration (classic-bridge effects source)
HORIZON_URL=https://horizon-testnet.stellar.org
HORIZON_API_TOKEN=

# Soroban RPC Configuration (contract state source)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org/rpc
SOROBAN_RPC_TOKEN=

# Webhook target (indexer dashboard - Issue #2)
WEBHOOK_URL=http://localhost:8080/webhooks/reconciler

# Consistency & polling
CONSISTENCY_WINDOW_MS=30000
POLL_INTERVAL_MS=5000

# Logging
LOG_LEVEL=INFO
SERVICE_NAME=streampay-reconciler
ENVIRONMENT=testnet
RECONCILER_ID=primary-001
# ---- Three-way reconciliation (Soroban RPC + Horizon + indexer projection) ----
# Indexer HTTP API exposing /health and /streams/:id. Empty disables the
# projection source; a missing source degrades the report, it never turns a
# disagreement into a clean verdict.
INDEXER_URL=http://localhost:8080
INDEXER_API_TOKEN=
AS_OF_MAX_LAG_LEDGERS=5
# Rounding tolerance on 7-decimal token amounts: absolute stroops plus a
# relative part per million.
ROUNDING_TOLERANCE_ABSOLUTE=0
ROUNDING_TOLERANCE_PPM=0
# Alert dedup cooldown and flap suppression (same diagnosis recurring).
SUPPRESSION_COOLDOWN_MS=300000
FLAP_THRESHOLD=3

# ---- Governance-gated auto-heal proposals ----
# Set to false to disable proposal generation/execution entirely.
HEAL_PROPOSALS_ENABLED=true
HEAL_TIMELOCK_MS=86400000
HEAL_TTL_MS=172800000
HEAL_REQUIRED_SIGNATURES=2
# JSON array/object of trusted approver names to ed25519 public keys (PEM).
# Malformed JSON fails startup closed. An empty list means nobody can approve.
HEAL_SIGNERS=[]
HEAL_MAX_SCOPE=25
HEAL_MAX_LEDGER_RANGE=1000
