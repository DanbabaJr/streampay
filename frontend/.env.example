# Soroban RPC endpoint. Defaults to Stellar testnet when unset.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase snippet used by the UI: TESTNET or PUBLIC
NEXT_PUBLIC_NETWORK=TESTNET

# Deployed StreamingPayments contract id (stellar contract deploy output)
NEXT_PUBLIC_STREAMING_CONTRACT_ID=

# Optional: contract id used for the create form's "Native XLM" choice.
# Defaults to the network's native XLM Stellar Asset Contract
# (`stellar contract id asset --network <net> --asset native`).
NEXT_PUBLIC_NATIVE_XLM_CONTRACT_ID=
