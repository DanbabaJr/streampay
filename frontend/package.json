{
  "name": "streampay-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal StreamPay UI: create streams, withdraw accrued funds, top up or cancel — Next.js + Freighter.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test && vitest run",
    "test:i18n": "vitest run lib/i18n/catalog.spec.ts",
    "test:accrual": "node --test lib/accrual.test.ts",
    "test:scheduler": "vitest run",
    "test:parity": "node --experimental-strip-types --test test/client-parity.test.ts",
    "test:a11y": "node --experimental-strip-types --test test/a11y.test.ts",
    "generate:openapi": "npx tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.2.1",
    "intl-messageformat": "^12.1.3",
    "next": "^16.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "4.10.3",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.8",
    "jsdom": "30.1.3",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "toml": "4.3.0"
  }
}
