    "accept": {
      "type": "boolean",
      "x-soroban-type": "bool"
    },
    "bond": {
      "type": "integer",
      "x-soroban-type": "i128"
    },
    "sender": {
      "description": "Stellar account or contract address (StrKey).",
      "type": "string",
      "x-soroban-type": "Address"
    }
  },
  "required": [
    "sender",
    "accept",
    "bond"
  ],
  "title": "DisputeResolved",
  "type": "object",
